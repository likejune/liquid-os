# kernel.spec supplies the Liquid suffix through --define "buildid .liquid".
# Keeping this empty makes uname -r match the RPM module directory.
CONFIG_LOCALVERSION=""
CONFIG_DEFAULT_HOSTNAME="liquid"
CONFIG_EROFS_FS=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_EFI_STUB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_SCHED_AUTOGROUP=y
